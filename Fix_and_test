class SafeArgs:
    def __init__(self):
        self.backbone = 'vit_tiny'; self.encoder = 'vit_tiny'; self.vit_encoder_num_layers = 12
        self.projector_scale = ['P3', 'P4', 'P5', 'P6']; self.out_feature_indexes = [2, 5, 8, 11]
        self.num_feature_levels = 4; self.hidden_dim = 256; self.dim_feedforward = 1024
        self.dec_layers = 6; self.sa_nheads = 8; self.ca_nheads = 8; self.nheads = 8
        self.num_queries = 100; self.dec_n_points = 4; self.decoder_norm = 'LN'
        self.dataset_file = 'coco'; self.device = 'cuda' if torch.cuda.is_available() else 'cpu'
        self.position_embedding = 'sine'; self.pretrained_encoder = None; self.window_block_indexes = []
        self.set_cost_class = 1.0; self.set_cost_bbox = 5.0; self.set_cost_giou = 2.0
        self.cls_loss_coef = 1.0; self.bbox_loss_coef = 5.0; self.giou_loss_coef = 2.0
        self.focal_alpha = 0.25; self.use_dn = False; self.num_select = 100; self.group_detr = 1
        self.with_box_refine = False; self.two_stage = False; self.ia_bce_loss = False
        self.v_loss_alpha = 0.75; self.v_loss_gamma = 2.0; self.use_varifocal_loss = False
    def __getattr__(self, name): return False

# =====================================================================
# ADIM 3: AĞIRLIKLARI YÜKLE VE BAĞIMLILIKLARI TEMİZLE
# =====================================================================
os.makedirs('weights', exist_ok=True)
weights_path = 'weights/LWDETR_tiny_60e_coco.pth'

if not os.path.exists(weights_path) or os.path.getsize(weights_path) < 1000000:
    hf_url = "https://huggingface.co/xbsu/LW-DETR/resolve/main/pretrain_weights/LWDETR_tiny_60e_coco.pth"
    try:
        urllib.request.urlretrieve(hf_url, weights_path)
        print("✅ ADIM 2: Ağırlık dosyası indirmesi başarılı!")
    except Exception as e:
        print(f"⚠️ İndirme başarısız: {e}")
else:
    print("✅ ADIM 2: Ağırlıklar zaten sistemde mevcut.")

try:
    if os.path.exists(weights_path):
        checkpoint = torch.load(weights_path, map_location='cpu', weights_only=False)
        args = checkpoint.get('args', SafeArgs())
        args.pretrained_encoder = None 
        args.device = 'cuda' if torch.cuda.is_available() else 'cpu'
        if not hasattr(args, 'use_dn'): args.use_dn = False
    else:
        args = SafeArgs()

    model, _, _ = build_model(args)
    
    if os.path.exists(weights_path):
        model.load_state_dict(checkpoint['model'], strict=False)
        print("✅ ADIM 3: Mimari, konfigürasyon (args) ile hatasız bağlandı.")
    else:
        print("⚠️ ADIM 3: Model rastgele ağırlıklarla kuruldu.")
        
    model.to(args.device)
    model.eval()
except Exception as e:
    print(f"❌ ADIM 3 HATASI: Model inşası çöktü: {e}")
    traceback.print_exc()
    sys.exit(1)

# =====================================================================
# ADIM 4 & 5: GÖRSEL TEST
# =====================================================================
try:
    url = 'https://raw.githubusercontent.com/pytorch/hub/master/images/dog.jpg'
    image = Image.open(requests.get(url, stream=True).raw).convert('RGB')
    transform = T.Compose([
        T.Resize((640, 640)), 
        T.ToTensor(),
        T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    img_tensor = transform(image).unsqueeze(0).to(args.device)

    with torch.no_grad():
        outputs = model(img_tensor)
        
    probas = outputs['pred_logits'].softmax(-1)[0, :, :-1]
    keep = probas.max(-1).values > 0.4 
    bboxes_scaled = outputs['pred_boxes'][0, keep]
    
    print("✅ ADIM 4: Çıkarım (Inference) başarıyla tamamlandı.")
    
    plt.figure(figsize=(10, 6))
    plt.imshow(image)
    ax = plt.gca()
    for p, (x, y, w, h) in zip(probas[keep], bboxes_scaled.cpu()):
        W, H = image.size
        box = [(x-w/2)*W, (y-h/2)*H, (x+w/2)*W, (y+h/2)*H]
        ax.add_patch(plt.Rectangle((box[0], box[1]), box[2]-box[0], box[3]-box[1], fill=False, color='red', linewidth=3))
    plt.axis('off')
    plt.title("LW-DETR (Tam Fonksiyonel Python Sürümü)")
    plt.show()
    print("✅ ADIM 5: Görsel test ekrana basıldı.")
except Exception as e:
    print(f"❌ ADIM 4/5 HATASI: {e}")
    traceback.print_exc()
    sys.exit(1)
